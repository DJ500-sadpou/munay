# ============================================================
# Munay — Variables de entorno (.env.example)
# Copia a .env.local para desarrollo local:
#   cp .env.example .env.local
#
# IMPORTANTE (F4 — deploy):
#   • NEXT_PUBLIC_* se inlinean en BUILD — configúralas en Vercel
#     (Production + Preview) y en GitHub Secrets ANTES de deployar.
#   • La migración supabase/migrations/00023_f0_tickets_settings.sql
#     debe estar aplicada en Neon (tabla settings + columnas de tickets
#     + RPC expire_stale_orders_v2 con p_process_whatsapp).
#   • La migración 00023 YA se ejecutó en Neon sin errores (verificado).
# ============================================================

# ── Site ─────────────────────────────────────────────────────
# URL pública (se usa en sitemap, og tags, canonicals).
NEXT_PUBLIC_SITE_URL=https://munay-audited-v01.vercel.app

# [F3.3 #4] WhatsApp del negocio para wa.me (solo dígitos, sin '+').
# SIN esta var se usa el fallback +593959756845 de constants.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=593959756845

# ── Neon Postgres ────────────────────────────────────────────
# Connection string de Neon (proyecto munay).
DATABASE_URL=postgresql://munay_owner:npg_xxx@ep-xxx.neon.tech/munay?sslmode=require

# ── Clerk Auth ───────────────────────────────────────────────
# OBLIGATORIAS: sin ellas la app crashea (FLOW3-003).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Brevo (emails) ───────────────────────────────────────────
BREVO_API_KEY=xkeys-xxx
FROM_EMAIL="Munay <noreply@tudominio.com>"

# ── Cloudflare Turnstile (anti-bot) ──────────────────────────
# En dev sin configurar → modo dev permisivo (turnstile_not_configured).
# En producción con site+secret → challenge REAL (no usar testing keys).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...
TURNSTILE_SECRET_KEY=0x4AAA...

# ── Cron (expiración de órdenes y tickets) ───────────────────
# Protege /api/cron/expire-orders (comparación timing-safe).
# Genera con: openssl rand -hex 32
CRON_SECRET=

# ── Pagos (Kushki — modo demo por defecto) ───────────────────
PAYMENT_PROVIDER=kushki
PAYMENT_SANDBOX=true
KUSHKI_PUBLIC_KEY=
KUSHKI_PRIVATE_KEY=
# Obligatorio en producción (webhook exige firma).
KUSHKI_WEBHOOK_SECRET=

# ── Cloudinary (imágenes) ────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCTS_FOLDER=munay/products
