# =============================================================================
# Munay — Variables de Entorno
# =============================================================================
# Copia este archivo a .env.local y completa los valores.
# Las marcadas como [OBLIGATORIA] son necesarias para que la app funcione.
# =============================================================================

# --- Sitio (URL base) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Neon (Base de Datos Postgres)
# =============================================================================
# Obtener: neon connection-string --project-id <ID> --role-name neondb_owner
# [OBLIGATORIA]
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# =============================================================================
# Clerk (Autenticación)
# =============================================================================
# Obtener: clerk env pull  (después de clerk auth login)
# [OBLIGATORIA]
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx...
# CLERK_SECRET_KEY=sk_test_xxx...

# =============================================================================
# Brevo (Emails)
# =============================================================================
# Obtener: Dashboard Brevo → SMTP & API → API Keys
# [OBLIGATORIA]
# BREVO_API_KEY=xkeys-xxx...
# FROM_EMAIL=Munay <noreply@brevo.com>

# =============================================================================
# Cloudflare Turnstile (Captcha)
# =============================================================================
# Obtener: Dashboard Cloudflare → Turnstile → Add widget
# [RECOMENDADA - Testing keys disponibles]
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# =============================================================================
# Kushki (Pasarela de pagos)
# =============================================================================
# [OPCIONAL - Modo demo funciona sin estas]
# PAYMENT_PROVIDER=kushki
# PAYMENT_SANDBOX=true
# KUSHKI_PUBLIC_KEY=...
# KUSHKI_PRIVATE_KEY=...
# KUSHKI_WEBHOOK_SECRET=...

# =============================================================================
# Cron Jobs
# =============================================================================
# Generar con: openssl rand -hex 32
# [OBLIGATORIA para Vercel]
# CRON_SECRET=...

# =============================================================================
# Cloudinary (Imágenes de producto)
# =============================================================================
# Crear cuenta gratis en https://cloudinary.com
# [RECOMENDADA - Sin esto, las imágenes no se pueden subir]
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=123456789
# CLOUDINARY_API_SECRET=tu_api_secret
# CLOUDINARY_PRODUCTS_FOLDER=munay/products
