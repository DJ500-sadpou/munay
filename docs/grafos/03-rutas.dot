digraph Rutas {
  graph [ rankdir =TB, splines = "ortho", nodesep =0.3, ranksep =0.5 ];
  node [ shape =box, style = "filled", fontname = "Arial", fontsize =10 ];
  "/" [ label = "🏠 / (Landing)", fillcolor = "#e3f2fd", color = "#1976d2", style = "filled,rounded" ];
  "route_admin" [ label = "📄 /admin", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_admin_flash_codes" [ label = "📄 /admin/flash-codes", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_admin_flash_codes__id" [ label = "⚡ :id", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_admin_flash_codes_new" [ label = "📄 /admin/flash-codes/new", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_admin_login" [ label = "📄 /admin/login", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_admin_metrics" [ label = "📄 /admin/metrics", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_admin_orders" [ label = "📄 /admin/orders", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_admin_orders__id" [ label = "⚡ :id", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_admin_products" [ label = "📄 /admin/products", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_admin_products__id" [ label = "⚡ :id", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_admin_products_new" [ label = "📄 /admin/products/new", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_carrito" [ label = "📄 /carrito", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_catalogo" [ label = "📄 /catalogo", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_checkout" [ label = "📄 /checkout", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_checkout_cancelled" [ label = "📄 /checkout/cancelled", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_checkout_pending" [ label = "📄 /checkout/pending", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_checkout_success" [ label = "📄 /checkout/success", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_cuenta" [ label = "📄 /cuenta", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_cuenta_login" [ label = "📄 /cuenta/login", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_cuenta_ordenes" [ label = "📄 /cuenta/ordenes", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_cuenta_ordenes__id" [ label = "⚡ :id", fillcolor = "#fce4ec", color = "#c62828", style = "filled,rounded" ];
  "route_cuenta_puntos" [ label = "📄 /cuenta/puntos", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_flash" [ label = "📄 /flash", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_flash__code" [ label = "⚡ :code", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "route_p" [ label = "📄 /p", fillcolor = "#e8f5e9", color = "#388e3c", style = "filled,rounded" ];
  "route_p__slug" [ label = "⚡ :slug", fillcolor = "#fff3e0", color = "#f57c00", style = "filled,rounded" ];
  "/" -> "route_admin";
  "route_admin" -> "route_admin_flash_codes";
  "route_admin_flash_codes" -> "route_admin_flash_codes__id";
  "route_admin_flash_codes" -> "route_admin_flash_codes_new";
  "route_admin" -> "route_admin_login";
  "route_admin" -> "route_admin_metrics";
  "route_admin" -> "route_admin_orders";
  "route_admin_orders" -> "route_admin_orders__id";
  "route_admin" -> "route_admin_products";
  "route_admin_products" -> "route_admin_products__id";
  "route_admin_products" -> "route_admin_products_new";
  "/" -> "route_carrito";
  "/" -> "route_catalogo";
  "/" -> "route_checkout";
  "route_checkout" -> "route_checkout_cancelled";
  "route_checkout" -> "route_checkout_pending";
  "route_checkout" -> "route_checkout_success";
  "/" -> "route_cuenta";
  "route_cuenta" -> "route_cuenta_login";
  "route_cuenta" -> "route_cuenta_ordenes";
  "route_cuenta_ordenes" -> "route_cuenta_ordenes__id";
  "route_cuenta" -> "route_cuenta_puntos";
  "/" -> "route_flash";
  "route_flash" -> "route_flash__code";
  "/" -> "route_p";
  "route_p" -> "route_p__slug";
}
