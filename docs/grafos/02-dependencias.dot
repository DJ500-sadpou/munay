digraph Dependencias {
  graph [ rankdir =LR, splines = "true", nodesep =0.5, ranksep =1.0 ];
  node [ shape =box, style = "filled", fontname = "Arial", fontsize =9 ];
subgraph legend {
  graph [ label = "Leyenda", style = "dashed", color = "#bdbdbd", fontsize =11 ];
  "legend_app" [ label = "app", fillcolor = "#ffe0b2", color = "#ff9800", style = "filled,rounded", shape =box, fontsize =9 ];
  "legend_components" [ label = "components", fillcolor = "#c8e6c9", color = "#4caf50", style = "filled,rounded", shape =box, fontsize =9 ];
  "legend_lib" [ label = "lib", fillcolor = "#bbdefb", color = "#2196f3", style = "filled,rounded", shape =box, fontsize =9 ];
  "legend_store" [ label = "store", fillcolor = "#e1bee7", color = "#9c27b0", style = "filled,rounded", shape =box, fontsize =9 ];
  "legend_hooks" [ label = "hooks", fillcolor = "#f8bbd0", color = "#e91e63", style = "filled,rounded", shape =box, fontsize =9 ];
  "legend_types" [ label = "types", fillcolor = "#b2dfdb", color = "#009688", style = "filled,rounded", shape =box, fontsize =9 ];
}

